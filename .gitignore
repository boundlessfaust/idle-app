# ── Dependencies ─────────────────────────────────────────────────
node_modules/

# ── Bun ──────────────────────────────────────────────────────────
bun.lockb
# Keep bun.lock (text lockfile) if using Bun ≥1.1 — delete line below if so
# bun.lock

# ── pnpm (fallback) ───────────────────────────────────────────────
pnpm-lock.yaml
.pnpm-store/

# ── WXT build output ─────────────────────────────────────────────
.output/
.wxt/
*.zip
*-stats.txt
stats.html
web-ext.config.js
web-ext.config.ts
.webextrc

# ── TypeScript ────────────────────────────────────────────────────
*.tsbuildinfo
dist/

# ── Test & coverage ───────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Logs ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Environment (never commit secrets) ───────────────────────────
.env
.env.*
!.env.example

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Cache ────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.biome-cache/

# ── IDE (project-specific shared settings committed; personal excluded) ──
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
# .vscode/ intentionally NOT ignored — .vscode/settings.json is committed
# Add personal VS Code files to ~/.gitignore_global instead

# ── Devcontainer volumes (host-side bind mount artifacts) ────────
# Nothing to exclude — devcontainer runs in Docker, no host artifacts
